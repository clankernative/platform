+test "120 column boundary counts tabs and Unicode and retains unbreakable content" {
+    const gpa = std.testing.allocator;
+    for ([_]usize{ 120, 121 }) |columns| {
+        // value = [<identifier>, 0] occupies identifier length + 13 columns.
+        const name = try gpa.alloc(u8, columns - 13);
+        defer gpa.free(name);
+        @memset(name, 'a');
+        const input = try std.fmt.allocPrint(gpa, "value = [{s}, 0]\n", .{name});
+        defer gpa.free(input);
+        const output = try moduleFmtsStable(gpa, input, false);
+        defer gpa.free(output);
+        if (columns == 120) {
+            try std.testing.expectEqualStrings(input, output);
+        } else {
+            try std.testing.expect(!std.mem.eql(u8, input, output));
+        }
+    }
+    const unicode = "é" ** 108;
+    const unicode_input = "value = \"" ++ unicode ++ "\"\n";
+    const unicode_output = try moduleFmtsStable(gpa, unicode_input, false);
+    defer gpa.free(unicode_output);
+    try std.testing.expectEqualStrings(unicode_input, unicode_output);
+
+    for ([_]usize{ 120, 121 }) |columns| {
+        const name = try gpa.alloc(u8, columns - 17);
+        defer gpa.free(name);
+        @memset(name, 'a');
+        const nested = try std.fmt.allocPrint(gpa, "Methods :: [].{{\n\tvalue = [{s}, 0]\n}}\n", .{name});
+        defer gpa.free(nested);
+        const formatted = try moduleFmtsStable(gpa, nested, false);
+        defer gpa.free(formatted);
+        try std.testing.expectEqual(columns == 120, std.mem.eql(u8, nested, formatted));
+    }
+
+    const literal = "https://example.com/" ++ "segment/" ** 30;
+    const input = "# " ++ literal ++ "\nvalue = \"" ++ literal ++ "\"\n";
+    const output = try moduleFmtsStable(gpa, input, false);
+    defer gpa.free(output);
+    try std.testing.expect(std.mem.indexOf(u8, output, "# " ++ literal ++ "\n") != null);
+    try std.testing.expect(std.mem.indexOf(u8, output, "\"" ++ literal ++ "\"") != null);
+    const original_shape = try widthTestParserShape(gpa, input);
+    defer gpa.free(original_shape);
+    const output_shape = try widthTestParserShape(gpa, output);
+    defer gpa.free(output_shape);
+    try std.testing.expectEqualStrings(original_shape, output_shape);
+}
