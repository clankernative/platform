+fn widthTestParserShape(gpa: std.mem.Allocator, source: []const u8) ![]const u8 {
+    var env = try ModuleEnv.init(gpa, source);
+    defer env.deinit();
+    const ast = try parse.file(gpa, &env.common);
+    defer ast.deinit();
+    try std.testing.expectEqual(@as(usize, 0), ast.parse_diagnostics.items.len);
+    var tree = base.SExprTree.init(gpa);
+    defer tree.deinit();
+    try ast.store.getFile().pushToSExprTree(gpa, &env.common, ast, &tree);
+    var result: std.Io.Writer.Allocating = .init(gpa);
+    defer result.deinit();
+    try tree.toStringPretty(&result.writer, .skip_linecol);
+    return result.toOwnedSlice();
+}
