+        "result = |first_argument_with_a_descriptive_name, second_argument_with_a_descriptive_name, third_argument_with_a_descriptive_name| first_argument_with_a_descriptive_name\n",
+        "result = first_value_with_a_descriptive_name + second_value_with_a_descriptive_name + third_value_with_a_descriptive_name + fourth_value_with_a_descriptive_name\n",
+        "transform : FirstArgumentWithADescriptiveName, SecondArgumentWithADescriptiveName, ThirdArgumentWithADescriptiveName -> ResultWithADescriptiveName\n",
+        "Variant : [FirstVariantWithADescriptiveName(Str), SecondVariantWithADescriptiveName(Str), ThirdVariantWithADescriptiveName(Str)]\n",
+        "Record : { first_field_with_a_descriptive_name : Str, second_field_with_a_descriptive_name : Str, third_field_with_a_descriptive_name : Str, ..others }\n",
+        "Tuple : (FirstArgumentWithADescriptiveName, SecondArgumentWithADescriptiveName, ThirdArgumentWithADescriptiveName, FourthArgumentWithADescriptiveName)\n",
+        "result = outer(inner(first_argument_with_a_descriptive_name, second_argument_with_a_descriptive_name), third_argument_with_a_descriptive_name)\n",
+        "result = call({ first_field_with_a_descriptive_name: first_value_with_a_descriptive_name, second_field_with_a_descriptive_name: second_value_with_a_descriptive_name })\n",
+        "result = \"Prefix ${call(first_argument_with_a_descriptive_name, second_argument_with_a_descriptive_name, third_argument_with_a_descriptive_name)} suffix\"\n",
+        "result = match input { FirstVariantWithADescriptiveName(_) | SecondVariantWithADescriptiveName(_) | ThirdVariantWithADescriptiveName(_) => 1 }\n",
+        "import SomeModule exposing [first_export_with_a_descriptive_name, second_export_with_a_descriptive_name, third_export_with_a_descriptive_name]\n",
