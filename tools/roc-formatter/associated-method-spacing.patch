+        "result = initial_value_with_a_descriptive_name |> first_transform_with_a_descriptive_name |> second_transform_with_a_descriptive_name\n",
+        "result = initial_value_with_a_descriptive_name.first_transform_with_a_descriptive_name().second_transform_with_a_descriptive_name()\n",
