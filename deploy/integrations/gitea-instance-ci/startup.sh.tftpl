#!/bin/bash
# Runs as root on every boot (GCE startup-script). Installs Docker once, then
# runs the pinned act_runner controller, registered to exactly one repository.
# Rendered by OpenTofu: $${...} is a literal shell expansion.
set -euo pipefail

state_dir=/var/lib/gitea-instance-ci
install -d -m 0700 "$state_dir"
exec 9>"$state_dir/startup.lock"
flock -n 9 || { echo "runner startup is already running" >&2; exit 1; }

if [[ ! -f "$state_dir/provisioned-v1" ]]; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y --no-install-recommends ca-certificates curl gnupg jq
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  # shellcheck disable=SC1091
  . /etc/os-release
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $${VERSION_CODENAME} stable" \
    >/etc/apt/sources.list.d/docker.list
  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io
  systemctl enable --now docker
  touch "$state_dir/provisioned-v1"
fi
systemctl start docker

# The controller image is act_runner's Docker-in-Docker build: it runs its
# own Docker daemon in a privileged container, and jobs run inside that daemon.
# The host's Docker socket is never mounted. Job containers are configured
# without a Docker socket ("-"), privileges or host volumes. This is not a
# hostile-code containment qualification; admit only trusted private-instance
# workflows. One job at a time.
cat >"$state_dir/config.yaml" <<'YAML'
log:
  level: info
runner:
  file: .runner
  # Declared on every start, so a changed job image needs no re-registration.
  labels:
    - "${runner_label}:docker://${job_image}"
  capacity: 1
  timeout: 3h
  insecure: false
  fetch_timeout: 5s
  fetch_interval: 2s
cache:
  enabled: false
container:
  network: ""
  privileged: false
  options: ""
  workdir_parent: ""
  valid_volumes: []
  docker_host: "-"
  force_pull: false
YAML

# First boot only: register with the repository-scoped token from Secret
# Manager. The token is never logged; afterwards the runner's own credential
# in .runner is what it uses, and the token is no longer needed.
if [[ ! -s "$state_dir/.runner" ]]; then
  access_token="$(curl -fsS -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' | jq -r .access_token)"
  registration_token="$(curl -fsS -H "Authorization: Bearer $${access_token}" \
    'https://secretmanager.googleapis.com/v1/${registration_secret}:access' | jq -r .payload.data | base64 -d)"
  [[ -n "$registration_token" ]] || { echo "empty runner registration token" >&2; exit 1; }
  umask 077
  printf 'GITEA_RUNNER_REGISTRATION_TOKEN=%s\n' "$registration_token" >"$state_dir/registration.env"
  unset registration_token access_token
fi

docker rm -f act_runner >/dev/null 2>&1 || true
env_file_args=()
[[ -f "$state_dir/registration.env" ]] && env_file_args=(--env-file "$state_dir/registration.env")
install -d -m 0700 /var/lib/gitea-instance-ci-docker
%{ if warm_job_image ~}
# Job images live in the inner daemon, not the host daemon. Warm the reviewed
# digest there before starting the configured runner. The temporary daemon and
# runner must never open the shared data directory concurrently. Registry auth
# stays in RAM in the temporary container, outside the job containers.
existing_runner="$(docker container ls --all --quiet --filter 'name=^/act_runner$')"
[[ -z "$existing_runner" ]] || { echo "prior runner was not removed" >&2; exit 1; }
docker rm -f act_runner_prewarm >/dev/null 2>&1 || true
trap 'docker rm -f act_runner_prewarm >/dev/null 2>&1 || true' EXIT
docker run -d --rm --name act_runner_prewarm --privileged \
  -v /var/lib/gitea-instance-ci-docker:/var/lib/docker \
  --tmpfs /root/.docker:rw,nosuid,nodev,noexec,mode=0700 \
  -e DOCKER_TLS_CERTDIR= \
  -e DOCKER_HOST=unix:///var/run/docker.sock \
  --entrypoint dockerd-entrypoint.sh \
  '${controller_image}' dockerd --host=unix:///var/run/docker.sock

ready=false
for _ in $(seq 1 30); do
  if timeout 3 docker exec act_runner_prewarm docker info >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 1
done
[[ "$ready" == true ]] || { echo "job-image daemon did not become ready" >&2; exit 1; }
if ! docker exec act_runner_prewarm docker image inspect '${job_image}' >/dev/null 2>&1; then
  access_token="$(curl -fsS --connect-timeout 5 --max-time 30 --retry 3 \
    -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
    | jq -er '.access_token | select(type == "string" and length > 0)')"
  printf '%s' "$access_token" | docker exec -i act_runner_prewarm \
    docker login -u oauth2accesstoken --password-stdin '${registry_host}' >/dev/null
  unset access_token
  timeout 600 docker exec act_runner_prewarm docker pull '${job_image}'
fi
[[ "$(docker exec act_runner_prewarm docker image inspect --format '{{.Os}}/{{.Architecture}}' '${job_image}')" == linux/amd64 ]] || \
  { echo "job image must be native linux/amd64" >&2; exit 1; }
docker stop --time 60 act_runner_prewarm >/dev/null
trap - EXIT
%{ endif ~}
docker run -d --name act_runner --restart=always --privileged \
  -v "$state_dir:/data" \
  -v /var/lib/gitea-instance-ci-docker:/var/lib/docker \
  -e CONFIG_FILE=/data/config.yaml \
  -e GITEA_INSTANCE_URL='${gitea_url}' \
  -e GITEA_RUNNER_NAME='${runner_name}' \
  -e GITEA_RUNNER_LABELS='${runner_label}:docker://${job_image}' \
  "$${env_file_args[@]}" \
  '${controller_image}'

# Once registered, drop the one-time token from disk.
for _ in $(seq 1 60); do
  if [[ -s "$state_dir/.runner" ]]; then
    rm -f "$state_dir/registration.env"
    break
  fi
  sleep 5
done
