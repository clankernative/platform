(version 1)(deny default)
        (allow file-read-metadata)
        (allow file-read-data (vnode-type DIRECTORY))
        (allow file-read* (subpath (param "PRIVATE_JOB")) (subpath "/System") (subpath "/usr/lib")
            (subpath "/usr/share") (subpath "/Library/Developer") (subpath "/Applications/Xcode_16.4.app")
            (subpath "/usr/bin") (subpath "/bin") (literal "/dev/null") (literal "/dev/urandom")
            (literal "/private/etc/ssl/openssl.cnf")
            (literal "/Library/Preferences/com.apple.dt.Xcode.plist"))
        (allow file-write* (subpath (param "PRIVATE_JOB")) (literal "/dev/null"))
        (allow process-fork)
        (allow process-exec (subpath (param "PRIVATE_JOB")) (subpath "/usr/bin") (subpath "/bin")
            (subpath "/Library/Developer") (subpath "/Applications/Xcode_16.4.app"))
        (allow iokit-open (iokit-registry-entry-class "RootDomainUserClient"))
        (allow sysctl-read)
        (allow mach-lookup (global-name "com.apple.system.logger")
            (global-name "com.apple.PowerManagement.control"))
