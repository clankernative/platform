# One build graph; tests and runtime campaigns always execute fresh.
startup --host_jvm_args=-Xmx768m
common --lockfile_mode=error
common --enable_platform_specific_config
build --jobs=2
build --define=DAY2_PLATFORM_JOBS=2
build --define=DAY2_PLATFORM_FEATURE_SCOPE=verification
build --local_resources=cpu=2
build --local_resources=memory=4096
build --compilation_mode=fastbuild
build --verbose_failures
build --show_timestamps
build --announce_rc
build --guard_against_concurrent_changes
build --experimental_disk_cache_gc_max_size=2G
build --experimental_disk_cache_gc_max_age=7d
build --experimental_disk_cache_gc_idle_delay=0
# The detected Linux C++ toolchain otherwise injects deprecated gold into Rust
# links. Use the existing GNU binutils linker for both targets and build tools;
# keep strict compiler warnings fatal instead of filtering the diagnostic.
build:linux --linkopt=-fuse-ld=bfd
build:linux --host_linkopt=-fuse-ld=bfd
test --cache_test_results=no
test --test_output=errors
# Keep largest Linux harness compilation within the existing CI memory budget.
build:ci-linux --jobs=1
build:ci-linux --define=DAY2_PLATFORM_JOBS=1
build:ci-linux --define=DAY2_PLATFORM_CODEGEN_UNITS=256
build:ci-linux --local_resources=cpu=2
# The test-preparation job supplies a one-token GNU jobserver. Bazel's action
# limit alone does not constrain rustc's otherwise 32-token LLVM backend pool.
build:ci-linux --action_env=CARGO_MAKEFLAGS
build:ci-mac --jobs=3
build:ci-mac --define=DAY2_PLATFORM_JOBS=3
build:ci-mac --local_resources=cpu=3

# Distribution builds preserve the former release panic/profile policy.
build:release --compilation_mode=opt
build:release --define=DAY2_PLATFORM_RUST_PROFILE=release
build:production --define=DAY2_PLATFORM_FEATURE_SCOPE=production

# The Linux runtime previously selected release strip=symbols. Native worker
# archives use release without this final-executable distribution setting.
build:distribution --config=release
build:distribution --config=production
build:distribution --@rules_rust//rust/settings:extra_rustc_flag=-Cstrip=symbols
