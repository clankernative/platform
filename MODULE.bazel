module(name = "day2_platform", version = "0.0.0")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Numeric child-status diagnostics; upstream source and version stay pinned.
single_version_override(
    module_name = "rules_rust",
    version = "0.74.0",
    patches = [
        "//build/bazel:patches/rules-rust-0.74.0-child-status.patch",
        "//build/bazel:patches/rules-rust-0.74.0-platform-profiles.patch",
        "//build/bazel:patches/rules-rust-0.74.0-build-script-inputs.patch",
        "//build/bazel:patches/rules-rust-0.74.0-clippy-enforcement.patch",
    ],
    patch_strip = 1,
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.1"],
    extra_target_triples = [],
    opt_level = {"fastbuild": "2", "dbg": "2", "opt": "3"},
    extra_rustc_flags = ["-Cembed-bitcode=no", "-Cdebuginfo=0"],
    extra_exec_rustc_flags = ["-Cembed-bitcode=no", "-Cdebuginfo=0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
            "//:Cargo.toml",
            "//crates/worker:Cargo.toml",
            "//crates/xtask:Cargo.toml",
            "//crates/day2:Cargo.toml",
            "//crates/day2-assets:Cargo.toml",
            "//crates/day2-contracts:Cargo.toml",
            "//crates/day2-control:Cargo.toml",
            "//crates/day2-kernel:Cargo.toml",
            "//crates/day2-capabilities:Cargo.toml",
            "//crates/durable-temporal:Cargo.toml",
            "//crates/day2-ops:Cargo.toml",
            "//crates/day2-sandbox:Cargo.toml",
            "//cli/checks:Cargo.toml"
    ],
    supported_platform_triples = ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin", "aarch64-unknown-linux-gnu"],
    skip_cargo_lockfile_overwrite = True,
)

