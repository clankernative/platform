module(name = "day2_bazel_experiment", version = "0.0.0")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.1"],
    extra_target_triples = [],
    opt_level = {"fastbuild": "2", "dbg": "2", "opt": "2"},
    extra_rustc_flags = ["-Cdebuginfo=0", "-Cdebug-assertions=on", "-Coverflow-checks=on"],
    extra_exec_rustc_flags = ["-Cdebuginfo=0", "-Cdebug-assertions=on", "-Coverflow-checks=on"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
            "//:Cargo.toml",
            "//:crates/worker/Cargo.toml",
            "//crates/xtask:Cargo.toml",
            "//crates/day2:Cargo.toml",
            "//crates/day2-assets:Cargo.toml",
            "//crates/day2-contracts:Cargo.toml",
            "//crates/day2-control:Cargo.toml",
            "//crates/day2-kernel:Cargo.toml",
            "//crates/day2-capabilities:Cargo.toml",
            "//crates/durable-temporal:Cargo.toml",
            "//crates/day2-ops:Cargo.toml",
            "//crates/day2-sandbox:Cargo.toml",
            "//:cli/checks/Cargo.toml"
    ],
    supported_platform_triples = ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin"],
    skip_cargo_lockfile_overwrite = True,
)

# Experiment-only dependency contexts; source archives and tool versions stay pinned.
crate.annotation(
    crate = "getrandom",
    version = "0.4.3",
    patches = ["//experiments/bazel:patches/getrandom-0.4.3-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "hashbrown",
    version = "0.17.1",
    patches = ["//experiments/bazel:patches/hashbrown-0.17.1-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "indexmap",
    version = "2.14.2",
    patches = ["//experiments/bazel:patches/indexmap-2.14.2-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "libc",
    version = "0.2.189",
    patches = ["//experiments/bazel:patches/libc-0.2.189-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "linux-raw-sys",
    version = "0.12.1",
    patches = ["//experiments/bazel:patches/linux-raw-sys-0.12.1-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "log",
    version = "0.4.34",
    patches = ["//experiments/bazel:patches/log-0.4.34-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "phf",
    version = "0.14.0",
    patches = ["//experiments/bazel:patches/phf-0.14.0-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "regex-automata",
    version = "0.4.18",
    patches = ["//experiments/bazel:patches/regex-automata-0.4.18-cargo-context.patch"],
    patch_args = ["-p1"],
)
crate.annotation(
    crate = "rustix",
    version = "1.1.4",
    patches = ["//experiments/bazel:patches/rustix-1.1.4-cargo-context.patch"],
    patch_args = ["-p1"],
