    version = "0.2.189",
    patches = ["//build/bazel:patches/libc-0.2.189-cargo-context.patch"],
    patch_args = ["-p1"],
)
# Actual opened-file observations for the closed native SQLite adapter. The
# pinned upstream implementation reports Unix VFS descriptors; this does not
# make the observation DATA into native ownership or permission.
crate.annotation(
    crate = "libsqlite3-sys",
    version = "0.39.1",
    patches = [
        "//build/bazel:patches/libsqlite3-sys-0.39.1-filestat-identity.patch",
        # SQLite 3.54.1 registers WALSTAT under FILESTAT, unlike its definition.
        # Match the definition guard; keep FILESTAT without enabling WALSTAT.
        "//build/bazel:patches/libsqlite3-sys-0.39.1-walstat-registration.patch",
    ],
    patch_args = ["-p1"],
    build_script_env = {"LIBSQLITE3_FLAGS": "-DSQLITE_ENABLE_FILESTAT"},
)

