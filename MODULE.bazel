module(name = "day2_platform", version = "0.0.0")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Numeric child-status diagnostics; upstream source and version stay pinned.
single_version_override(
    module_name = "rules_rust",
    version = "0.74.0",
    patches = [
        "//build/bazel:patches/rules-rust-0.74.0-child-status.patch",
        "//build/bazel:patches/rules-rust-0.74.0-platform-profiles.patch",
        "//build/bazel:patches/rules-rust-0.74.0-build-script-inputs.patch",
        "//build/bazel:patches/rules-rust-0.74.0-clippy-enforcement.patch",
        "//build/bazel:patches/rules-rust-0.74.0-required-tool-checksums.patch",
    ],
    patch_strip = 1,
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.100.0"],
    extra_target_triples = [],
    opt_level = {"fastbuild": "2", "dbg": "2", "opt": "3"},
    extra_rustc_flags = ["-Cembed-bitcode=no", "-Cdebuginfo=0"],
    extra_exec_rustc_flags = ["-Cembed-bitcode=no", "-Cdebuginfo=0"],
    # rules_rust's built-in table has no 1.100.0 entries. The required-checksums
    # patch refuses any tool archive without one, so a version bump must replace
    # this table. Values are the xz_hash entries of the signed
    # channel-rust-<version>.toml for each supported host's toolchain archives.
    sha256s = {
        "cargo-1.100.0-aarch64-apple-darwin.tar.xz": "7e18265d2d2cda8dec6cac4d0faa3bbafe927b401e5185350abc7d669f9adafb",
        "clippy-1.100.0-aarch64-apple-darwin.tar.xz": "fb57f639b5b9bcf1262df1ff81bcfc9e44338fbc729b0d5aad531b96493d6391",
        "llvm-tools-1.100.0-aarch64-apple-darwin.tar.xz": "855138deaa04b955a7dadef55e7d583c5bbefd9fb7db6879aac126c4e4c2e526",
        "rust-std-1.100.0-aarch64-apple-darwin.tar.xz": "9345645b6f56eea28bf8cc2c0f628a61d507a688f91c1bec5ae6bfad216a16c7",
        "rustc-1.100.0-aarch64-apple-darwin.tar.xz": "3fcd7f1709f62dda58bf4db2dcfd630a451e750aadaaa551a21cc4a627a37b4c",
        "cargo-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "d07ee80eb6ba3c5845c554ac88086e1ff5d63f83d99c3c09cb32504cbedd6844",
        "clippy-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "941f71acaf2a181d66776b3b889b72d64a90cc405b8f6c41a4b5ac8cd99a36b1",
        "llvm-tools-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "929514c642010b884575525fce876d3fb9b9eeec76cd825b79b3b917a7088fc6",
        "rust-std-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "c73f62fbe5d837f9807ed9e0076575dd8d3475c79af2b30e3570d328e6713f8f",
        "rustc-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "fcbfa5b8a0cb28f0c4edfb6dda6910ee910993db31f05258613f5cd5b851263a",
        "cargo-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "7e29ce07d7c6e92d1826870575ba27d57fff6cb3e754aa57d99099cb88fab35d",
        "clippy-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "0d18df3bff6c852ef8243727fed075ecb33dbf93b8ab8c138c2f45e3f270102a",
        "llvm-tools-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "2c84cada1aef73339b1a2d101a35cd78d71072c8f6a3921bf1abb852c3f42ad3",
        "rust-std-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "4591b6486594ded52ecd6135db95bf9355bbd3ca7a380888b141528bbcf9a5d4",
        "rustc-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "f1d0b1dec81dab6f523cd098507763487b0d4bd7fd2c87582f154128719be03b",
    },
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
            "//:Cargo.toml",
            "//crates/worker:Cargo.toml",
            "//crates/xtask:Cargo.toml",
            "//crates/day2:Cargo.toml",
            "//crates/day2-assets:Cargo.toml",
            "//crates/day2-contracts:Cargo.toml",
            "//crates/day2-control:Cargo.toml",
            "//crates/day2-kernel:Cargo.toml",
            "//crates/day2-capabilities:Cargo.toml",
            "//crates/durable-temporal:Cargo.toml",
            "//crates/day2-ops:Cargo.toml",
            "//crates/day2-sandbox:Cargo.toml",
            "//cli/checks:Cargo.toml"
    ],
    supported_platform_triples = ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin", "aarch64-unknown-linux-gnu"],
    skip_cargo_lockfile_overwrite = True,
)

# Explicit target/build-tool dependency contexts, with locked source inputs.
crate.annotation(
    crate = "errno",
    version = "0.3.14",
    patches = ["//build/bazel:patches/errno-0.3.14-cargo-context.patch"],
    patch_args = ["-p1"],
)
