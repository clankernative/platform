+// This fixed numeric advisory never includes command arguments, paths, or environment values.
+// A requested metadata kill is not evidence that the kill succeeded or caused termination.
+fn status_code_with_diagnostic(
+    status: ExitStatus,
+    was_killed: bool,
+    diagnostic: &mut impl io::Write,
+) -> i32 {
+    let code = status_code(status, was_killed);
+    if code != 0 {
+        let child_code = status.code();
+        #[cfg(unix)]
+        let signal = {
+            use std::os::unix::process::ExitStatusExt;
+            status.signal()
+        };
+        #[cfg(not(unix))]
+        let signal: Option<i32> = None;
+        // Diagnostic I/O failure must not replace the original mapped child status.
+        let _ = writeln!(
+            diagnostic,
+            "RR_CHILD_V1 code_present={} code={} signal_present={} signal={} metadata_kill_requested={}",
+            u8::from(child_code.is_some()),
+            child_code.unwrap_or(0),
+            u8::from(signal.is_some()),
+            signal.unwrap_or(0),
+            u8::from(was_killed),
+        );
+    }
+    code
 }
 
