 #if defined(SQLITE_DEBUG) || defined(SQLITE_ENABLE_FILESTAT)
+/* Actual open-file identity DATA only. Never duplicate or close a descriptor:
+** closing another same-inode fd could release this process's POSIX locks.
+** On observation failure emit null, not a pathname-derived identity.
+*/
+static void unixDescribeFdIdentity(sqlite3_str *pStr, int fd){
+  struct stat st;
+  sqlite3_str_appendall(pStr, ",\"identity\":");
+  if( osFstat(fd, &st)!=0 || !S_ISREG(st.st_mode)
+   || sizeof(st.st_dev)>sizeof(sqlite3_uint64)
+   || sizeof(st.st_ino)>sizeof(sqlite3_uint64)
+  ){
+    sqlite3_str_appendall(pStr, "null");
+  }else{
+    sqlite3_str_appendf(pStr,
+        "{\"device\":%llu,\"inode\":%llu}",
+        (sqlite3_uint64)st.st_dev, (sqlite3_uint64)st.st_ino);
+  }
+}
  static void unixDescribeShm(sqlite3_str*,unixShm*);
 #endif
