    crate_root = "src/bin/day2-provision-credentials.rs",
    srcs = glob(["src/**/*.rs"]) + glob(["tests/**/*.rs"], allow_empty = True),
    compile_data = COMPILE_INPUTS,
    internal_deps = INTERNAL_DEPS,
    own_library = ":lib",
